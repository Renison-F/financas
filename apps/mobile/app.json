{
  "expo": {
    "name": "SerenaCash",
    "slug": "serenacash",
    "scheme": "serenacash",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.serenacash.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "O SerenaCash usa a câmera para ler etiquetas de preço e códigos de barras durante as compras.",
        "NSFaceIDUsageDescription": "Proteja seus dados financeiros com Face ID.",
        "NSPhotoLibraryUsageDescription": "Anexe comprovantes às suas despesas.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "br.com.serenacash.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B5563",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.CAMERA", "android.permission.USE_BIOMETRIC", "android.permission.VIBRATE"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "locales": {},
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F6F5",
          "dark": { "backgroundColor": "#0C1517" }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O SerenaCash usa a câmera para ler etiquetas de preço e códigos de barras durante as compras.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        { "faceIDPermission": "Proteja seus dados financeiros com Face ID." }
      ],
      [
        "expo-notifications",
        { "color": "#0B5563" }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
